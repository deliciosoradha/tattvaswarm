# TattvaSwarm — environment template
# Copy to .env and fill in. NEVER commit real keys.
#
# Better: keep secrets out of the repo entirely — put them in
#   $TATTVA_HOME/nebius.env   (default: ~/.tattva/nebius.env)
# The loader reads .env first and then that private file.

# --- Nebius Token Factory (OpenAI-compatible) ---
# Get a key: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Model tiers (NVIDIA open-source models) ---
# Verified live against GET /v1/models + chat completions (HTTP 200, 2026-10-19).
TATTVA_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
TATTVA_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
TATTVA_MODEL_HEAVY=nvidia/Nemotron-3-Ultra-550b-a55b
# Optional vision tier (multimodal demos): nvidia/Nemotron-3.5-Super-VL

# --- Optional: research tier via Tavily (bonus) ---
# TAVILY_API_KEY=

# --- Local sovereign home (memory, tasks, logs) ---
# Nothing here leaves the machine.
TATTVA_HOME=~/.tattva
