rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ledger chain: Append-only by service accounts, read-only public for verification
    match /ledger_chain/{blockId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false; // strictly append-only
    }

    // Evaluations: Read-only public once sealed
    match /evaluations/{runId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Agent cards: Authenticated agents only
    match /agents_cards/{agentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
