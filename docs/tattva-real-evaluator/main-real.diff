+/// Ejecuta un comando con timeout (ms) y devuelve su stdout si terminó a tiempo.
+fn run_with_timeout(program: &str, args: &[String], timeout_ms: u64) -> Option<String> {
+    use std::sync::mpsc;
+    let (tx, rx) = mpsc::sync_channel::<std::io::Result<std::process::Output>>(1);
+    let program = program.to_string();
+    let args: Vec<String> = args.to_vec();
+    std::thread::spawn(move || {
+        let out = std::process::Command::new(&program)
+            .args(&args)
+            .stdout(std::process::Stdio::piped())
+            .stderr(std::process::Stdio::null())
+            .output();
+        let _ = tx.send(out);
+    });
+    match rx.recv_timeout(std::time::Duration::from_millis(timeout_ms)) {
+        Ok(Ok(output)) if output.status.success() => {
+            Some(String::from_utf8_lossy(&output.stdout).trim().to_string())
+        }
+        _ => None,
+    }
+}
