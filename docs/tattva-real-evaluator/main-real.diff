+/// Recoge las señales vivas del sistema: sensor eBPF dharma-xdp (:8151/metrics)
+/// y evidencia condensada reciente vía `rtk smart` sobre el último reporte.
+fn detect_signals() -> atman::SignalContext {
+    let mut sig = atman::SignalContext::default();
+
+    // Señal 1: sensor dharma-xdp (telemetría eBPF viva).
+    let agent = ureq::AgentBuilder::new()
+        .timeout(std::time::Duration::from_millis(1500))
+        .build();
+    if let Ok(resp) = agent.get("http://127.0.0.1:8151/metrics").call() {
+        if let Ok(body) = resp.into_string() {
+            sig.sensor_alive = true;
+            sig.sensor_metrics = body.lines().filter(|l| !l.starts_with('#') && !l.trim().is_empty()).count() as u64;
+            for line in body.lines() {
+                if let Some(rest) = line.strip_prefix("radhika_amenazas_eventos_total ") {
+                    sig.sensor_events = rest.trim().parse().unwrap_or(0);
+                }
+            }
+        }
+    }
+
+    // Señal 2: evidencia condensada — `rtk smart` sobre el .md más reciente de lab-master.
+    let reports_dir = std::path::PathBuf::from(
+        std::env::var("HOME").unwrap_or_else(|_| "/home/delideli".to_string()),
+    )
+    .join("lab-master/reports");
+    let mut newest: Option<(std::time::SystemTime, std::path::PathBuf)> = None;
+    if let Ok(rd) = std::fs::read_dir(&reports_dir) {
+        for entry in rd.flatten() {
+            let p = entry.path();
+            if !p.is_dir() {
+                continue;
+            }
+            if let Ok(sub) = std::fs::read_dir(&p) {
+                for f in sub.flatten() {
+                    let fp = f.path();
+                    if fp.extension().and_then(|e| e.to_str()) == Some("md") {
+                        if let Ok(mtime) = fp.metadata().and_then(|m| m.modified()) {
+                            if newest.as_ref().map(|(t, _)| mtime > *t).unwrap_or(true) {
+                                newest = Some((mtime, fp));
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if let Some((_, path)) = newest {
+        let path_str = path.to_string_lossy().into_owned();
+        let args = vec!["smart".to_string(), path_str];
+        if let Some(summary) = run_with_timeout("rtk", &args, 4000) {
+            let first_lines: Vec<&str> = summary.lines().take(2).collect();
+            if !first_lines.is_empty() {
+                sig.evidence_summary = Some(first_lines.join(" | "));
+            }
+        }
+    }
+
+    sig
+}
